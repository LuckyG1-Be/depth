{
  "name": "depth",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:check": "npm run prisma:validate && npm run prisma:generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "prisma db seed",
    "check": "npm run prisma:check && npm run typecheck && next build",
    "bootstrap": "npm install && npm run prisma:generate && npm run db:push && npm run seed && npm run dev",
    "reset:hard": "rm -rf node_modules package-lock.json && npm install && npm run prisma:generate && npm run db:push && npm run seed",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.9.2",
    "sharp": "^0.33.5",
    "twilio": "^5.12.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "husky": "^9.1.7",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
