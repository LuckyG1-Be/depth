{
  "name": "depth",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "opennextjs-cloudflare build --skip-next-build",
    "build:next": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:cloudflare": "npm run build",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --keep-vars",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "test": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:check": "npm run prisma:validate && npm run prisma:generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "prisma db seed",
    "check": "npm run prisma:check && npm run typecheck && next build",
    "bootstrap": "npm install && npm run prisma:generate && npm run db:push && npm run seed && npm run dev",
    "reset:hard": "rm -rf node_modules package-lock.json && npm install && npm run prisma:generate && npm run db:push && npm run seed",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-d1": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.5.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.9.2",
    "sharp": "^0.33.5",
    "stripe": "^22.6.2",
    "twilio": "^5.12.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "husky": "^9.1.7",
    "postcss": "^8.4.47",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.143.0"
  }
}
